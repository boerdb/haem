# Kopieer naar scripts/.secrets.local (gitignored)
DB_HOST=192.168.1.14
SSH_USER=root
# SSH gaat met een sleutel, niet met een wachtwoord
SSH_KEY_PATH=~/.ssh/id_ed25519_homelab
# SSH_KEY_PASSPHRASE=  (alleen als de sleutel een wachtzin heeft)
MYSQL_ROOT_PASS=your_password
HAEMO_DB_PASS=your_password
